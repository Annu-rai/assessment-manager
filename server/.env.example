# Server configuration
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/assessment_app
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/assessment_app?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/assessment_app

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins for CORS (frontend URLs)
CLIENT_ORIGIN=http://localhost:5173

# --- AI features (Module 5/6): AI Question Generator, AI Evaluation ---
# Get a key from https://console.anthropic.com/ . When unset, AI features are
# disabled gracefully (the "Generate with AI" button hides itself).
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-8

# --- Email invites (Module 13) ---
# When EMAIL_HOST is unset, invites are logged (not delivered) but the link
# still works. Configure SMTP to actually send.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Assessments <no-reply@assessments.local>
